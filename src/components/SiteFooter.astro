---
import { site } from '@/data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer-inner">
    <p class="muted">
      © {year} {site.name}. Built with <a href="https://astro.build/">Astro</a>.
    </p>
    <ul class="links">
      <li><a href={site.github}>GitHub</a></li>
      <li><a href={site.scholar}>Scholar</a></li>
      <li><a href={site.orcid}>ORCID</a></li>
      <li><a href={`mailto:${site.email}`}>Email</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 0 3rem;
    margin-top: 2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer p {
    margin: 0;
    font-size: 0.9rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects, site } from '@/data/site';
---

<BaseLayout title="Projects" description="Software, CFD, and machine learning projects by Ali AliAkbari.">
  <section class="section page-head">
    <div class="shell">
      <p class="eyebrow">Selected work</p>
      <h1 class="display">Projects</h1>
      <p class="muted">
        Open-source code is on <a href={site.github}>GitHub</a> (@Ali-AliAkbari).
      </p>
    </div>
  </section>

  <section class="section section-end">
    <div class="shell card-grid cols-2">
      {
        projects.map((p) => (
          <article class="card project">
            <div class="top">
              <p class="eyebrow">{p.period}</p>
              <h2>{p.title}</h2>
            </div>
            <p class="muted">{p.summary}</p>
            <div class="tags">
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head h1 {
    margin: 0.35rem 0 0.5rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
  }

  .project h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0.2rem 0 0.75rem;
    line-height: 1.3;
  }

  .section-end {
    padding-bottom: 5rem;
    padding-top: 0;
  }
</style>